# Copia como backend/.env (no se versiona). Ningún valor real del servidor va en el repositorio.

# Puerto y host del API. En el servidor, el frontend (puerto 4046) reenvía /api aquí.
PUERTO=4054
# 127.0.0.1 = solo accesible desde la misma máquina (recomendado detrás del servidor del frontend).
HOST=127.0.0.1

# Base de datos SQLite (archivo). Debe quedar fuera de cualquier carpeta pública.
RUTA_BD=./datos/aura.db

# Orígenes desde los que el navegador puede llamar al API (coma entre varios).
# En producción: el origen público del frontend, p. ej. https://aura.ejemplo.edu o http://<ip>:4046
ORIGENES_PERMITIDOS=http://localhost:4046,http://localhost:5173

# Cookie de sesión solo por HTTPS. Desactívala SOLO si el servidor aún no tiene HTTPS (inseguro; ver docs/15).
COOKIE_SEGURA=true

# Usar X-Forwarded-For para el límite de peticiones (true si el API está detrás del servidor del frontend).
CONFIAR_PROXY=true

# Clave de la API de Anthropic (Claude) para las evaluaciones con IA. Sin ella, se desactivan.
CLAUDE_API_KEY=

NODE_ENV=production
