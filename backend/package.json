{
  "name": "aura-backend",
  "private": true,
  "version": "0.1.0",
  "description": "API de AURA: cuentas, sincronización de datos y validación del progreso",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/servidor.ts",
    "dev": "node --env-file-if-exists=.env --watch src/servidor.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "bd:resumen": "node --env-file-if-exists=.env src/resumenBd.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.9.0"
  },
  "overrides": {
    "@babel/runtime": "7.29.14",
    "standardwebhooks": "1.1.1"
  }
}
