# Seguridad de la cadena de suministro (ver docs/04-riesgos.md, R6–R8)
# No ejecutar scripts de instalación de dependencias; autorizar excepciones de forma explícita.
ignore-scripts=true
# Versiones exactas en package.json; el lockfile fija el árbol completo.
save-exact=true
engine-strict=true
fund=false
