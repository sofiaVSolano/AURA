{
  "name": "aura",
  "private": true,
  "version": "0.0.0",
  "description": "AURA — Acompañamiento Universitario, Reflexión y Aprendizaje",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/publicar-medios.ts",
    "build:dev": "tsc -b && vite build --mode development && node scripts/publicar-medios.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build",
    "fixture:video": "node scripts/fixture-video.mjs",
    "medios:movil": "node scripts/medios-movil.ts",
    "test:e2e": "node tests/e2e/funcional.mjs",
    "test:auditoria": "npm run build && node tests/e2e/auditoria.mjs",
    "servir": "node servidor/servidor.mjs",
    "test:integracion": "npm run build && node tests/e2e/integracion.mjs"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
