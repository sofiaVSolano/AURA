# Copia como frontend/.env.servidor (no se versiona). Configura `npm run servir` (servidor de producción).
# Puerto público del frontend.
PUERTO=4046
# 0.0.0.0 para aceptar conexiones externas; 127.0.0.1 si hay un proxy HTTPS delante (recomendado).
HOST=0.0.0.0
# Dónde escucha el backend (misma máquina).
API_URL=http://127.0.0.1:4054
# Ruta pública (igual que VITE_BASE_PATH al compilar).
BASE_PATH=/
# true cuando el sitio se sirve por HTTPS (añade HSTS).
HTTPS_PUBLICO=false
