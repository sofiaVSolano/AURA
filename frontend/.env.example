# Copia este archivo como .env.local para sobrescribir valores en tu máquina.
# IMPORTANTE: toda variable VITE_* se incrusta en el JavaScript público.
# Nunca pongas aquí secretos, claves ni credenciales.

# Ruta pública donde se servirá la app. "/" en la raíz del dominio,
# "/aura/" si el servidor la publica en un subdirectorio. Debe terminar en "/".
VITE_BASE_PATH=/

# URL base de los recursos audiovisuales. Vacío = "<VITE_BASE_PATH>media/".
# Ej.: https://media.ejemplo.edu/aura/ si los videos se alojan aparte.
VITE_MEDIA_BASE_URL=

# Perfil de contenido institucional (universidad/metodología). Ver docs/08-despliegue.md.
VITE_CONTENT_PROFILE=default

# Cuentas y sincronización con el backend (false = solo datos en el navegador).
VITE_API_HABILITADA=true

# Solo para el servidor de desarrollo (no se expone al cliente).
# "true" permite abrir la app desde otros dispositivos de la red local (p. ej. probar en móvil).
AURA_DEV_EXPOSE=false

# Desarrollo: a dónde reenvía Vite las llamadas a /api (backend local).
AURA_API_URL=http://127.0.0.1:4054
